# Скопируй в `.env` (dotenv грузится автоматически). Ничего обязательного нет:
# дефолты уже корректны, ниже — всё, что можно поменять.

# --- HTTP ---
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
# Пусто = без авторизации (безопасно только на loopback).
# Ставь токен, если BRIDGE_HOST=0.0.0.0 или мост торчит в LAN/Tailscale.
BRIDGE_TOKEN=
BRIDGE_LOG_LEVEL=info

# --- драйвер ---
# deepseek_web = управлять Chromium со страницей чата; fake = заглушка для отладки API
BRIDGE_PROVIDER=deepseek_web
DEEPSEEK_CHAT_URL=https://chat.deepseek.com
# Первый логин возможен только с видимым окном: headless=false до тех пор, пока
# `python -m bridge.cli status` не покажет logged_in=true.
BRIDGE_HEADLESS=false
BRIDGE_LOGIN_TIMEOUT_S=600
BRIDGE_READY_TIMEOUT_S=20

# --- генерация (мы читаем DOM, поэтому тут паузы, а не streaming-сокет) ---
BRIDGE_GENERATION_TIMEOUT_S=240
BRIDGE_POLL_MS=350
BRIDGE_STABLE_POLLS=3
# Сколько ждём появления НОВОГО блока ответа, прежде чем признать, что ответа нет
BRIDGE_START_TIMEOUT_S=25
# Сколько ждём очищения поля ввода после Enter = подтверждение, что сообщение ушло
BRIDGE_SEND_WAIT_S=10
# Сколько ждём, пока страница выйдет из режима генерации перед отправкой
BRIDGE_IDLE_WAIT_S=45
# Сколько последних блоков ответа читать за один опрос (окно, а не весь диалог)
BRIDGE_ANSWER_WINDOW=10
# enter | button | auto (auto: Enter, потом кнопка, потом Enter ещё раз)
BRIDGE_SUBMIT=auto
# true = при сбое слать снимок страницы в data/debug/ (без него правка селекторов — угадывание)
BRIDGE_DEBUG_DUMP=true
BRIDGE_QUEUE_WAIT_S=120
BRIDGE_MAX_WAITERS=8

# --- прочее ---
BRIDGE_DATA_DIR=./data
# Файл с переопределёнными селекторами — нужен, когда DeepSeek сменит вёрстку.
BRIDGE_SELECTORS_FILE=
# Доп. origin'ы для CORS (например, если клиент живёт на http://127.0.0.1:3000)
BRIDGE_CORS_ALLOW_ORIGINS=
